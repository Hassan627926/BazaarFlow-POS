rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Global Hardened Primitives ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticatedUser() {
      return isSignedIn() &&
        request.auth.token.email is string;
    }

    function isVerifiedEmailUser() {
      return isAuthenticatedUser() &&
        request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function storeExists(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId));
    }

    function storeOwnerId(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId;
    }

    function isStoreOwner(storeId) {
      return storeExists(storeId) && storeOwnerId(storeId) == request.auth.uid;
    }

    function isRetailStore(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.businessType == 'retail';
    }

    function isRestaurantStore(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.businessType == 'restaurant';
    }

    // Master Gate: Synchronous Waiter RBAC verification backed by owner-controlled /waiterAccess grant
    // Note: /waiterMembers/{uid} can ONLY be created when email_verified == true (first Google sign-in),
    // so checking the existing member doc + live /waiterAccess grant stays immune to email squatting
    // even after the waiter links an Email/Password credential.
    function isActiveWaiter(storeId) {
      return isAuthenticatedUser() &&
        exists(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.active == true &&
        exists(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)) &&
        get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data.storeId == storeId &&
        get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data.active == true &&
        get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data.waiterEmail == authEmailLower();
    }

    function waiterCanEditOrders(storeId) {
      return !('canEditOrders' in get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data) ||
        get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data.canEditOrders == true;
    }

    function waiterCanSettleBills(storeId) {
      return !('canSettleBills' in get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data) ||
        get(/databases/$(database)/documents/waiterAccess/$(get(/databases/$(database)/documents/stores/$(storeId)/waiterMembers/$(request.auth.uid)).data.accessId)).data.canSettleBills == true;
    }

    function hasMatchingActiveGrant(data, storeId) {
      return isValidId(data.accessId) &&
        exists(/databases/$(database)/documents/waiterAccess/$(data.accessId)) &&
        get(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.storeId == storeId &&
        get(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.ownerId == data.ownerId &&
        get(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.employeeId == data.employeeId &&
        get(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.waiterEmail == authEmailLower() &&
        get(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.active == true;
    }

    function hasOwnerMatchingGrantAfter(data, storeId) {
      return isValidId(data.accessId) &&
        existsAfter(/databases/$(database)/documents/waiterAccess/$(data.accessId)) &&
        getAfter(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.storeId == storeId &&
        getAfter(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.ownerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.employeeId == data.employeeId &&
        getAfter(/databases/$(database)/documents/waiterAccess/$(data.accessId)).data.waiterEmail == data.waiterEmail;
    }

    // ── Validation Blueprints (Anti-Update-Gap) ─────────────────────────────
    function isValidStore(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'businessType', 'logoDataUrl', 'primaryColor',
          'accentColor', 'currency', 'taxRate', 'address', 'phone',
          'receiptFooter', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'businessType', 'logoDataUrl', 'primaryColor',
          'accentColor', 'currency', 'taxRate', 'tableCount', 'address', 'phone',
          'receiptFooter', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.businessType in ['retail', 'restaurant'] &&
        data.logoDataUrl is string && data.logoDataUrl.size() <= 120000 &&
        isHexColor(data.primaryColor) &&
        isHexColor(data.accentColor) &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 50 &&
        (!('tableCount' in data) || (data.tableCount is number && data.tableCount >= 1 && data.tableCount <= 60)) &&
        data.address is string && data.address.size() <= 200 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.receiptFooter is string && data.receiptFooter.size() <= 180 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'name', 'sku', 'barcode', 'category',
          'costPrice', 'sellingPrice', 'stock', 'minStock', 'unit',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'name', 'sku', 'barcode', 'category',
          'costPrice', 'sellingPrice', 'stock', 'minStock', 'unit',
          'trackStock', 'variants', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.sku is string && data.sku.size() <= 40 &&
        data.barcode is string && data.barcode.size() <= 48 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 100000000 &&
        data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= 100000000 &&
        data.stock is number && data.stock >= 0 && data.stock <= 10000000 &&
        data.minStock is number && data.minStock >= 0 && data.minStock <= 1000000 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
        (!('trackStock' in data) || data.trackStock is bool) &&
        (!('variants' in data) || (data.variants is list && data.variants.size() <= 12 && (data.variants.size() == 0 || data.variants[0] is map))) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSale(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'invoiceNumber', 'dateKey', 'items',
          'itemCount', 'subtotal', 'discount', 'taxRate', 'taxAmount',
          'total', 'totalCost', 'profit', 'paymentMethod', 'amountTendered',
          'changeDue', 'orderType', 'tableNumber', 'customerName', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'invoiceNumber', 'dateKey', 'items',
          'itemCount', 'subtotal', 'discount', 'taxRate', 'taxAmount',
          'total', 'totalCost', 'profit', 'paymentMethod', 'amountTendered',
          'changeDue', 'orderType', 'tableNumber', 'customerName',
          'customerPhone', 'customerAddress', 'employeeId', 'employeeName',
          'settledBy', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40 &&
        data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 && data.items[0] is map &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 10000 &&
        data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000000 &&
        data.discount is number && data.discount >= 0 && data.discount <= 100000000 &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 50 &&
        data.taxAmount is number && data.taxAmount >= 0 && data.taxAmount <= 100000000 &&
        data.total is number && data.total >= 0 && data.total <= 100000000 &&
        data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 100000000 &&
        data.profit is number && data.profit >= -100000000 && data.profit <= 100000000 &&
        data.paymentMethod in ['cash', 'card', 'bank_qr'] &&
        data.amountTendered is number && data.amountTendered >= 0 && data.amountTendered <= 100000000 &&
        data.changeDue is number && data.changeDue >= 0 && data.changeDue <= 100000000 &&
        data.orderType in ['retail', 'dine_in', 'takeaway', 'delivery'] &&
        data.tableNumber is string && data.tableNumber.size() <= 20 &&
        data.customerName is string && data.customerName.size() <= 80 &&
        (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 32)) &&
        (!('customerAddress' in data) || (data.customerAddress is string && data.customerAddress.size() <= 220)) &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 128)) &&
        (!('employeeName' in data) || (data.employeeName is string && data.employeeName.size() <= 80)) &&
        (!('settledBy' in data) || data.settledBy in ['counter', 'waiter_mobile']) &&
        data.status in ['completed', 'voided'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStockLog(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'productId', 'productName', 'change',
          'previousStock', 'newStock', 'reason', 'note', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'productId', 'productName', 'change',
          'previousStock', 'newStock', 'reason', 'note', 'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 100 &&
        data.change is number && data.change >= -10000000 && data.change <= 10000000 &&
        data.previousStock is number && data.previousStock >= 0 && data.previousStock <= 10000000 &&
        data.newStock is number && data.newStock >= 0 && data.newStock <= 10000000 &&
        data.reason in ['restock', 'sale', 'void_restore', 'damage', 'adjustment'] &&
        data.note is string && data.note.size() <= 160 &&
        data.createdAt is timestamp;
    }

    function isValidTableSession(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'tableNumber', 'status', 'items',
          'itemCount', 'subtotal', 'totalCost', 'customerName',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'tableNumber', 'status', 'items',
          'itemCount', 'subtotal', 'totalCost', 'customerName',
          'employeeId', 'employeeName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 20 &&
        data.status == 'occupied' &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 && data.items[0] is map &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 10000 &&
        data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000000 &&
        data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 100000000 &&
        data.customerName is string && data.customerName.size() <= 80 &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 128)) &&
        (!('employeeName' in data) || (data.employeeName is string && data.employeeName.size() <= 80)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'name', 'phone', 'phoneDigits',
          'address', 'orderCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'name', 'phone', 'phoneDigits',
          'address', 'orderCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 32 &&
        data.phoneDigits is string && data.phoneDigits.size() >= 4 && data.phoneDigits.size() <= 24 && data.phoneDigits.matches('^[0-9]+$') &&
        data.address is string && data.address.size() <= 220 &&
        data.orderCount is number && data.orderCount >= 1 && data.orderCount <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEmployee(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'name', 'role', 'phone', 'cnic',
          'shift', 'notes', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'name', 'role', 'phone', 'cnic',
          'shift', 'notes', 'loginEmail', 'waiterUid', 'mobileAccess',
          'canEditOrders', 'canPrintKot', 'canViewPrices', 'canSettleBills',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 40 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.cnic is string && data.cnic.size() <= 32 &&
        data.shift is string && data.shift.size() <= 40 &&
        data.notes is string && data.notes.size() <= 160 &&
        (!('loginEmail' in data) || (data.loginEmail is string && data.loginEmail.size() <= 120)) &&
        (!('waiterUid' in data) || (data.waiterUid is string && data.waiterUid.size() <= 128)) &&
        (!('mobileAccess' in data) || data.mobileAccess is bool) &&
        (!('canEditOrders' in data) || data.canEditOrders is bool) &&
        (!('canPrintKot' in data) || data.canPrintKot is bool) &&
        (!('canViewPrices' in data) || data.canViewPrices is bool) &&
        (!('canSettleBills' in data) || data.canSettleBills is bool) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWaiterAccess(data) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'storeName', 'employeeId', 'employeeName',
          'role', 'waiterEmail', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'storeName', 'employeeId', 'employeeName',
          'role', 'waiterEmail', 'waiterUid', 'canEditOrders', 'canPrintKot',
          'canViewPrices', 'canSettleBills', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
        isValidId(data.employeeId) &&
        data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 80 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 40 &&
        data.waiterEmail is string && data.waiterEmail.size() >= 3 && data.waiterEmail.size() <= 120 &&
        (!('waiterUid' in data) || (data.waiterUid is string && data.waiterUid.size() <= 128)) &&
        (!('canEditOrders' in data) || data.canEditOrders is bool) &&
        (!('canPrintKot' in data) || data.canPrintKot is bool) &&
        (!('canViewPrices' in data) || data.canViewPrices is bool) &&
        (!('canSettleBills' in data) || data.canSettleBills is bool) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWaiterMember(data, storeId, memberUid) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'accessId', 'employeeId', 'employeeName',
          'waiterUid', 'waiterEmail', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'accessId', 'employeeId', 'employeeName',
          'waiterUid', 'waiterEmail', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        isValidId(data.accessId) &&
        isValidId(data.employeeId) &&
        data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 80 &&
        isValidId(data.waiterUid) &&
        data.waiterUid == memberUid &&
        data.waiterEmail is string && data.waiterEmail.size() >= 3 && data.waiterEmail.size() <= 120 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidKotTicket(data, storeId) {
      return data.keys().hasAll([
          'ownerId', 'storeId', 'ticketNumber', 'tableNumber', 'orderType',
          'ticketKind', 'items', 'itemCount', 'customerName', 'source',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'storeId', 'ticketNumber', 'tableNumber', 'orderType',
          'ticketKind', 'items', 'itemCount', 'changeNotes', 'customerName',
          'employeeId', 'employeeName', 'source', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.storeId) &&
        data.storeId == storeId &&
        data.ticketNumber is string && data.ticketNumber.size() >= 1 && data.ticketNumber.size() <= 40 &&
        data.tableNumber is string && data.tableNumber.size() <= 20 &&
        data.orderType in ['retail', 'dine_in', 'takeaway', 'delivery'] &&
        data.ticketKind in ['new', 'addon', 'revised', 'reprint'] &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 && data.items[0] is map &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 10000 &&
        (!('changeNotes' in data) || (data.changeNotes is list && data.changeNotes.size() <= 50 && (data.changeNotes.size() == 0 || data.changeNotes[0] is string))) &&
        data.customerName is string && data.customerName.size() <= 80 &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 128)) &&
        (!('employeeName' in data) || (data.employeeName is string && data.employeeName.size() <= 80)) &&
        data.source in ['waiter_mobile', 'counter'] &&
        data.status in ['pending', 'printed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ── /waiterAccess/{accessId} ────────────────────────────────────────────
    // Owner manages mobile waiter grants; waiter can only read their own grant
    match /waiterAccess/{accessId} {
      allow get: if isAuthenticatedUser() &&
        isValidId(accessId) && (
          existing().ownerId == request.auth.uid ||
          existing().waiterEmail == authEmailLower() ||
          ('waiterUid' in existing() && existing().waiterUid == request.auth.uid)
        );

      allow list: if isAuthenticatedUser() && (
        existing().ownerId == request.auth.uid ||
        existing().waiterEmail == authEmailLower() ||
        ('waiterUid' in existing() && existing().waiterUid == request.auth.uid)
      );

      allow create: if isAuthenticatedUser() &&
        isValidId(accessId) &&
        isValidWaiterAccess(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isStoreOwner(incoming().storeId);

      allow update: if isAuthenticatedUser() &&
        isValidId(accessId) &&
        isValidWaiterAccess(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().storeId == existing().storeId &&
        incoming().employeeId == existing().employeeId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isStoreOwner(existing().storeId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'employeeName', 'role', 'waiterEmail', 'waiterUid',
          'canEditOrders', 'canPrintKot', 'canViewPrices', 'canSettleBills', 'active', 'updatedAt'
        ]);

      allow delete: if isAuthenticatedUser() &&
        isValidId(accessId) &&
        existing().ownerId == request.auth.uid &&
        isStoreOwner(existing().storeId);
    }

    // ── /stores/{storeId} ───────────────────────────────────────────────────
    match /stores/{storeId} {
      allow get: if isAuthenticatedUser() &&
        isValidId(storeId) && (
          existing().ownerId == request.auth.uid ||
          isActiveWaiter(storeId)
        );

      allow list: if isAuthenticatedUser() &&
        existing().ownerId == request.auth.uid;

      allow create: if isAuthenticatedUser() &&
        isValidId(storeId) &&
        isValidStore(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAuthenticatedUser() &&
        isValidId(storeId) &&
        isValidStore(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: Update Brand & Store Settings
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'businessType', 'logoDataUrl', 'primaryColor', 'accentColor',
            'currency', 'taxRate', 'tableCount', 'address', 'phone', 'receiptFooter', 'updatedAt'
          ])
        );

      allow delete: if isAuthenticatedUser() &&
        isValidId(storeId) &&
        existing().ownerId == request.auth.uid;

      // ── /stores/{storeId}/waiterMembers/{memberUid} ───────────────────────
      match /waiterMembers/{memberUid} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(memberUid) && (
            memberUid == request.auth.uid ||
            isStoreOwner(storeId)
          );

        allow list: if isAuthenticatedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(memberUid) &&
          isValidWaiterMember(incoming(), storeId, memberUid) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            // Tier 1 (Owner): Provisioning a waiter login account directly inside Owner POS
            (
              isStoreOwner(storeId) &&
              incoming().ownerId == request.auth.uid &&
              hasOwnerMatchingGrantAfter(incoming(), storeId)
            ) ||
            // Tier 2 (Verified Waiter): Self-binding on first Google sign-in against active owner grant
            (
              isVerifiedEmailUser() &&
              memberUid == request.auth.uid &&
              incoming().waiterEmail == authEmailLower() &&
              incoming().active == true &&
              storeExists(storeId) &&
              incoming().ownerId == storeOwnerId(storeId) &&
              hasMatchingActiveGrant(incoming(), storeId)
            )
          );

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(memberUid) &&
          isValidWaiterMember(incoming(), storeId, memberUid) &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().waiterUid == existing().waiterUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'accessId', 'employeeId', 'employeeName', 'waiterEmail', 'active', 'updatedAt'
          ]) && (
            // Tier 1 (Owner): Updating/pausing waiter membership
            (
              existing().ownerId == request.auth.uid &&
              isStoreOwner(storeId)
            ) ||
            // Tier 2 (Waiter): Refreshing own active membership
            (
              memberUid == request.auth.uid &&
              incoming().waiterEmail == authEmailLower() &&
              incoming().active == true &&
              hasMatchingActiveGrant(incoming(), storeId)
            )
          );

        allow delete: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(memberUid) && (
            memberUid == request.auth.uid ||
            isStoreOwner(storeId)
          );
      }

      // ── /stores/{storeId}/products/{productId} ────────────────────────────
      match /products/{productId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(productId) && (
            (existing().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (existing().storeId == storeId && isActiveWaiter(storeId))
          );

        allow list: if isAuthenticatedUser() && (
          existing().ownerId == request.auth.uid ||
          (existing().storeId == storeId && isActiveWaiter(storeId))
        );

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(productId) &&
          isValidProduct(incoming(), storeId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId) &&
          (isRetailStore(storeId) || incoming().barcode == '');

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(productId) &&
          isValidProduct(incoming(), storeId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            // Tier 1 (Owner): Full product edits or stock updates
            (
              existing().ownerId == request.auth.uid &&
              isStoreOwner(storeId) && (
                (
                  (isRetailStore(storeId) || incoming().barcode == '') &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'name', 'sku', 'barcode', 'category', 'costPrice', 'sellingPrice',
                    'stock', 'minStock', 'unit', 'trackStock', 'variants', 'active', 'updatedAt'
                  ])
                ) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
              )
            ) ||
            // Tier 2 (Active Waiter): Stock adjustment ONLY when placing/editing table orders
            (
              isActiveWaiter(storeId) &&
              isRestaurantStore(storeId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
            )
          );

        allow delete: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(productId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);
      }

      // ── /stores/{storeId}/sales/{saleId} ──────────────────────────────────
      // Strictly owner-only: waiters cannot settle bills, void sales, or read revenue/profit
      match /sales/{saleId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(saleId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);

        allow list: if isAuthenticatedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(saleId) &&
          isValidSale(incoming(), storeId) &&
          incoming().status == 'completed' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            // Tier 1 (Owner): Full counter billing
            (
              incoming().ownerId == request.auth.uid &&
              isStoreOwner(storeId)
            ) ||
            // Tier 2 (Authorized Waiter): Settle occupied restaurant dine-in table bill & alert Counter
            (
              isActiveWaiter(storeId) &&
              isRestaurantStore(storeId) &&
              waiterCanSettleBills(storeId) &&
              incoming().ownerId == storeOwnerId(storeId) &&
              incoming().orderType == 'dine_in' &&
              'settledBy' in incoming() &&
              incoming().settledBy == 'waiter_mobile'
            )
          );

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(saleId) &&
          isValidSale(incoming(), storeId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId) &&
          // Terminal State Locking: only 'completed' -> 'voided' transition allowed
          existing().status == 'completed' &&
          incoming().status == 'voided' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if false;
      }

      // ── /stores/{storeId}/stockLogs/{logId} ───────────────────────────────
      match /stockLogs/{logId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(logId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);

        allow list: if isAuthenticatedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(logId) &&
          isValidStockLog(incoming(), storeId) &&
          incoming().createdAt == request.time && (
            (incoming().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (
              isActiveWaiter(storeId) &&
              isRestaurantStore(storeId) &&
              incoming().ownerId == storeOwnerId(storeId) &&
              incoming().reason in ['sale', 'adjustment']
            )
          );

        allow update, delete: if false;
      }

      // ── /stores/{storeId}/tables/{tableId} ────────────────────────────────
      match /tables/{tableId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(tableId) && (
            (existing().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (existing().storeId == storeId && isActiveWaiter(storeId))
          );

        allow list: if isAuthenticatedUser() && (
          existing().ownerId == request.auth.uid ||
          (existing().storeId == storeId && isActiveWaiter(storeId))
        );

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(tableId) &&
          isValidTableSession(incoming(), storeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            (incoming().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (
              isActiveWaiter(storeId) &&
              isRestaurantStore(storeId) &&
              incoming().ownerId == storeOwnerId(storeId)
            )
          );

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(tableId) &&
          isValidTableSession(incoming(), storeId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().tableNumber == existing().tableNumber &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (existing().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (isActiveWaiter(storeId) && isRestaurantStore(storeId))
          ) && (
            // Action: Update Occupied Table Items / Assigned Staff
            incoming().diff(existing()).affectedKeys().hasOnly([
              'items', 'itemCount', 'subtotal', 'totalCost', 'customerName',
              'employeeId', 'employeeName', 'updatedAt'
            ])
          );

        allow delete: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(tableId) && (
            (existing().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (
              isActiveWaiter(storeId) &&
              isRestaurantStore(storeId) &&
              (waiterCanEditOrders(storeId) || waiterCanSettleBills(storeId))
            )
          );
      }

      // ── /stores/{storeId}/customers/{customerId} ──────────────────────────
      // PII (phone, address) strictly owner-isolated (no waiter reads)
      match /customers/{customerId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(customerId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);

        allow list: if isAuthenticatedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(customerId) &&
          isValidCustomer(incoming(), storeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId);

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(customerId) &&
          isValidCustomer(incoming(), storeId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().phoneDigits == existing().phoneDigits &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId) && (
            // Action: Update Customer Name / Phone Formatting / Delivery Address / Order Count
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'address', 'orderCount', 'updatedAt'
            ])
          );

        allow delete: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(customerId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);
      }

      // ── /stores/{storeId}/employees/{employeeId} ──────────────────────────
      // Staff PII (phone, cnic, notes) strictly owner-isolated (no waiter reads)
      match /employees/{employeeId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(employeeId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);

        allow list: if isAuthenticatedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(employeeId) &&
          isValidEmployee(incoming(), storeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId);

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(employeeId) &&
          isValidEmployee(incoming(), storeId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId) && (
            // Action: Edit Employee Profile, Mobile Access, Permissions, or Active Status
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'role', 'phone', 'cnic', 'shift', 'notes',
              'loginEmail', 'waiterUid', 'mobileAccess',
              'canEditOrders', 'canPrintKot', 'canViewPrices', 'canSettleBills', 'active', 'updatedAt'
            ])
          );

        allow delete: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(employeeId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);
      }

      // ── /stores/{storeId}/kotQueue/{kotId} ────────────────────────────────
      // Real-time cloud KOT print queue (Waiter Mobile -> Counter / Kitchen Printer)
      match /kotQueue/{kotId} {
        allow get: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(kotId) && (
            (existing().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (existing().storeId == storeId && isActiveWaiter(storeId))
          );

        allow list: if isAuthenticatedUser() && (
          existing().ownerId == request.auth.uid ||
          (existing().storeId == storeId && isActiveWaiter(storeId))
        );

        allow create: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(kotId) &&
          isValidKotTicket(incoming(), storeId) &&
          incoming().status == 'pending' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            (incoming().ownerId == request.auth.uid && isStoreOwner(storeId)) ||
            (
              isActiveWaiter(storeId) &&
              isRestaurantStore(storeId) &&
              incoming().ownerId == storeOwnerId(storeId)
            )
          );

        allow update: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(kotId) &&
          isValidKotTicket(incoming(), storeId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().storeId == existing().storeId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isStoreOwner(storeId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if isAuthenticatedUser() &&
          isValidId(storeId) &&
          isValidId(kotId) &&
          existing().ownerId == request.auth.uid &&
          isStoreOwner(storeId);
      }
    }
  }
}
