{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "A brand workspace representing a retail shop or restaurant with custom branding, theme colors, logo, tax, currency, and restaurant table count settings.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "businessType": {
          "type": "string",
          "enum": ["retail", "restaurant"]
        },
        "logoDataUrl": {
          "type": "string",
          "maxLength": 120000
        },
        "primaryColor": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentColor": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "taxRate": {
          "type": "number"
        },
        "tableCount": {
          "type": "number",
          "description": "Optional number of dine-in tables for restaurant workspaces (1 to 60)."
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "receiptFooter": {
          "type": "string",
          "maxLength": 180
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "businessType",
        "logoDataUrl",
        "primaryColor",
        "accentColor",
        "currency",
        "taxRate",
        "address",
        "phone",
        "receiptFooter",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "An inventory item or menu dish belonging to a store.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sku": { "type": "string", "maxLength": 40 },
        "barcode": { "type": "string", "maxLength": 48 },
        "category": { "type": "string", "minLength": 1, "maxLength": 50 },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "name",
        "sku",
        "barcode",
        "category",
        "costPrice",
        "sellingPrice",
        "stock",
        "minStock",
        "unit",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "A completed or voided POS invoice transaction.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "dateKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "items": { "type": "array" },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "bank_qr"] },
        "amountTendered": { "type": "number" },
        "changeDue": { "type": "number" },
        "orderType": { "type": "string", "enum": ["retail", "dine_in", "takeaway", "delivery"] },
        "tableNumber": { "type": "string", "maxLength": 20 },
        "customerName": { "type": "string", "maxLength": 80 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "customerAddress": { "type": "string", "maxLength": 220 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["completed", "voided"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "invoiceNumber",
        "dateKey",
        "items",
        "itemCount",
        "subtotal",
        "discount",
        "taxRate",
        "taxAmount",
        "total",
        "totalCost",
        "profit",
        "paymentMethod",
        "amountTendered",
        "changeDue",
        "orderType",
        "tableNumber",
        "customerName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Immutable inventory stock adjustment audit record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "change": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string", "enum": ["restock", "sale", "void_restore", "damage", "adjustment"] },
        "note": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "productId",
        "productName",
        "change",
        "previousStock",
        "newStock",
        "reason",
        "note",
        "createdAt"
      ]
    },
    "TableSession": {
      "title": "TableSession",
      "description": "An active occupied restaurant dine-in table holding open order items for add-ons and final settlement.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tableNumber": { "type": "string", "minLength": 1, "maxLength": 20 },
        "status": { "type": "string", "enum": ["occupied"] },
        "items": { "type": "array" },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "totalCost": { "type": "number" },
        "customerName": { "type": "string", "maxLength": 80 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "tableNumber",
        "status",
        "items",
        "itemCount",
        "subtotal",
        "totalCost",
        "customerName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Saved delivery and takeaway customer contact history keyed by normalized phone number.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phone": { "type": "string", "minLength": 1, "maxLength": 32 },
        "phoneDigits": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[0-9]+$" },
        "address": { "type": "string", "maxLength": 220 },
        "orderCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "name",
        "phone",
        "phoneDigits",
        "address",
        "orderCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Employee": {
      "title": "Employee",
      "description": "Store staff member (waiter, cashier, rider, sales associate) assigned to tables and orders for owner accountability.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 },
        "phone": { "type": "string", "maxLength": 32 },
        "cnic": { "type": "string", "maxLength": 32 },
        "shift": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 160 },
        "loginEmail": { "type": "string", "maxLength": 120 },
        "waiterUid": { "type": "string", "maxLength": 128 },
        "mobileAccess": { "type": "boolean" },
        "canEditOrders": { "type": "boolean" },
        "canPrintKot": { "type": "boolean" },
        "canViewPrices": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "name",
        "role",
        "phone",
        "cnic",
        "shift",
        "notes",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "WaiterAccess": {
      "title": "WaiterAccess",
      "description": "Owner-issued mobile waiter access grant mapping a staff member's login email and permissions to a restaurant store for direct table ordering and KOT printing.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "employeeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 },
        "waiterEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "waiterUid": { "type": "string", "maxLength": 128 },
        "canEditOrders": { "type": "boolean" },
        "canPrintKot": { "type": "boolean" },
        "canViewPrices": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "storeName",
        "employeeId",
        "employeeName",
        "role",
        "waiterEmail",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "WaiterMember": {
      "title": "WaiterMember",
      "description": "Verified Firebase Auth UID binding created by an authorized waiter backed by an active WaiterAccess grant.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "accessId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "waiterUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "waiterEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "accessId",
        "employeeId",
        "employeeName",
        "waiterUid",
        "waiterEmail",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "KotTicket": {
      "title": "KotTicket",
      "description": "Real-time Kitchen Order Ticket queued from Waiter Mobile or Counter POS for live thermal printing at the Counter/Kitchen station.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ticketNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tableNumber": { "type": "string", "maxLength": 20 },
        "orderType": { "type": "string", "enum": ["retail", "dine_in", "takeaway", "delivery"] },
        "ticketKind": { "type": "string", "enum": ["new", "addon", "revised", "reprint"] },
        "items": { "type": "array" },
        "itemCount": { "type": "number" },
        "changeNotes": { "type": "array" },
        "customerName": { "type": "string", "maxLength": 80 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeName": { "type": "string", "maxLength": 80 },
        "source": { "type": "string", "enum": ["waiter_mobile", "counter"] },
        "status": { "type": "string", "enum": ["pending", "printed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "storeId",
        "ticketNumber",
        "tableNumber",
        "orderType",
        "ticketKind",
        "items",
        "itemCount",
        "customerName",
        "source",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Multi-tenant brand/store workspaces owned by authenticated store owners."
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Inventory items and menu dishes scoped to a specific store."
    },
    "/stores/{storeId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Completed and voided POS sales invoices scoped to a specific store."
    },
    "/stores/{storeId}/stockLogs/{logId}": {
      "schema": { "$ref": "#/entities/StockLog" },
      "description": "Append-only stock movement audit logs scoped to a specific store."
    },
    "/stores/{storeId}/tables/{tableId}": {
      "schema": { "$ref": "#/entities/TableSession" },
      "description": "Active occupied dine-in tables holding open orders and add-ons for restaurant workspaces."
    },
    "/stores/{storeId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Private store-owned customer directory for delivery and takeaway auto-fill history."
    },
    "/stores/{storeId}/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Private store-owned employee directory for order attribution and staff accountability."
    },
    "/waiterAccess/{accessId}": {
      "schema": { "$ref": "#/entities/WaiterAccess" },
      "description": "Owner-issued waiter mobile access grants linking waiter Google email to a restaurant store."
    },
    "/stores/{storeId}/waiterMembers/{memberUid}": {
      "schema": { "$ref": "#/entities/WaiterMember" },
      "description": "Verified waiter UID membership records used by Firestore security rules for synchronous revocation."
    },
    "/stores/{storeId}/kotQueue/{kotId}": {
      "schema": { "$ref": "#/entities/KotTicket" },
      "description": "Real-time cloud KOT print queue syncing mobile waiter orders directly to Counter/Kitchen thermal printers."
    }
  }
}
